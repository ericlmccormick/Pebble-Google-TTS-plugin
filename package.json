{
  "name": "pebble-universal-tts-plugin",
  "version": "1.2.0",
  "author": "Eric McCormick",
  "pebble": {
    "displayName": "Universal TTS",
    "uuid": "2c5edc42-b096-4f76-b284-1f27907e6502",
    "sdkVersion": "3",
    "manifestVersion": 2,
    "projectType": "plugin",
    "configPage": "src/config.html",
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "texttospeech.googleapis.com",
            "generativelanguage.googleapis.com",
            "api.elevenlabs.io",
            "speech.microsoft.com",
            "api.deepgram.com",
            "api.cartesia.ai",
            "api.speechify.ai",
            "api.smallest.ai",
            "api.inworld.ai",
            "api.fish.audio",
            "coda.api.rime.ai",
            "docs.rime.ai"
          ]
        }
      },
      {
        "name": "LocalNetwork"
      }
    ],
    "plugin": {
      "description": "Provider-independent Pebble TTS with live voice and model discovery, 12 speech services, and verified 8 kHz audio. Apps call one speak() method.",
      "script": "src/plugin/index.js",
      "definesPermissions": [
        {
          "name": "UniversalTtsSpeak",
          "label": "Synthesize text with the user's selected speech provider",
          "kind": "exfiltrating"
        },
        {
          "name": "UniversalTtsRead",
          "label": "Check Universal TTS availability and provider",
          "kind": "read"
        }
      ],
      "actions": [
        {
          "name": "tts_prepare",
          "description": "Synthesize text with the user's chosen provider; return a verified WAV session, including first chunk.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "test_tone": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "callerPermissions": [
            "UniversalTtsSpeak"
          ]
        },
        {
          "name": "tts_chunk",
          "description": "Fetch base64 WAV chunk by session_id and aligned offset; includes checksum.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "session_id",
              "offset"
            ],
            "additionalProperties": false
          },
          "callerPermissions": [
            "UniversalTtsSpeak"
          ]
        },
        {
          "name": "tts_release",
          "description": "Delete temporary audio session and its chunks.",
          "parameters": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              }
            },
            "required": [
              "session_id"
            ],
            "additionalProperties": false
          },
          "callerPermissions": [
            "UniversalTtsSpeak"
          ]
        },
        {
          "name": "tts_status",
          "description": "Return selected provider status and audio format, never credentials.",
          "parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "callerPermissions": [
            "UniversalTtsRead"
          ]
        }
      ]
    }
  },
  "description": "Provider-independent text to speech for Pebble watch apps and watchfaces"
}
